# Local path containing Telegram Desktop's result.json and exported media.
TELEGRAM_EXPORT_PATH=C:/path/to/Exported Chat
IMPORTER_TAG=latest

# Existing PostgreSQL instance. Use the database host's trusted LAN address.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=mediaarchivist
POSTGRES_USER=mediaarchivist
POSTGRES_PASSWORD=

# OpenAI-compatible vision endpoint.
VISION_API_KEY=
VISION_BASE_URL=https://anymodel.org/v1
VISION_MODEL=ag/gemini-3.7-flash-medium
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=3

# The importer Compose stack supplies this Ollama service.
OLLAMA_HOST=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024

# Local media processing.
WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_VIDEO_FRAMES=12
