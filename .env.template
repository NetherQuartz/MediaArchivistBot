POSTGRES_HOST=db
POSTGRES_PORT=5432
# Keep loopback unless a trusted LAN client needs direct database access.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=mediaarchivist
POSTGRES_USER=mediaarchivist
POSTGRES_PASSWORD=change-me

# Compose pulls ghcr.io/netherquartz/mediaarchivistbot:latest by default.
# For local image builds use: BOT_PULL_POLICY=build
BOT_PULL_POLICY=always

LOGGING_LEVEL=INFO

# AnyModel is the default OpenAI-compatible vision provider.
VISION_API_KEY=
VISION_BASE_URL=https://anymodel.org/v1
VISION_MODEL=ag/gemini-3.7-flash-medium
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=3

OLLAMA_HOST=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024

WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

MAX_FILE_SIZE=20000000
MAX_VIDEO_FRAMES=12
# When true, index media posted by other bots. This bot's own messages are
# always skipped to avoid feedback loops.
INDEX_BOT_MEDIA=false
INDEXING_WORKERS=1
MEMBERSHIP_CONCURRENCY=5
SEARCH_CANDIDATES=40
SEARCH_RESULTS=5
MAX_COSINE_DISTANCE=0.65

TG_TOKEN=
